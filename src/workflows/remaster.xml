<beast version="2.7" namespace="beast.base.inference:beast.base.inference.parameter:remaster">

  <run spec="Simulator" nSims="$(nSims)">
    <simulate spec="SimulatedTree" id="tree">

      <trajectory spec="StochasticTrajectory" id="traj" maxTime="$(maxTime)" mustHave="sample &gt;= $(minSamples)" endsWhen="sample==$(maxSamples)">

        <population spec="RealParameter" id="S" value="$(S0)"/>
        <population spec="RealParameter" id="E" value="$(E0)"/>
        <population spec="RealParameter" id="Ia" value="0"/>
        <population spec="RealParameter" id="Ip" value="0"/>
        <population spec="RealParameter" id="Is" value="0"/>
        <samplePopulation spec="RealParameter" id="sample" value="0"/>

        <reaction spec="Reaction" rate="$(beta_a)"> S + Ia:1 -> Ia:1 + E:1 </reaction>
        <reaction spec="Reaction" rate="$(beta_p)"> S + Ip:1 -> Ip:1 + E:1 </reaction>
        <reaction spec="Reaction" rate="$(beta_s)"> S + Is:1 -> Is:1 + E:1 </reaction>
        <reaction spec="Reaction" rate="$(e_to_ia)"> E -> Ia </reaction>
        <reaction spec="Reaction" rate="$(e_to_ip)"> E -> Ip </reaction>
        <reaction spec="Reaction" rate="$(ip_to_is)"> Ip -> Is </reaction>
        <reaction spec="Reaction" rate="$(ia_to_r)"> Ia -> 0 </reaction>
        <reaction spec="Reaction" rate="$(is_to_r)"> Is -> 0 </reaction>

        <reaction spec="Reaction" rate="0 $(psi)" changeTimes="$(startSampling)"> Is -> sample </reaction>

      </trajectory>
    </simulate>

    <logger spec="Logger" fileName="$(filebase).traj">
     <log idref="traj"/>
    </logger>

    <logger fileName="$(filebase).trees" mode="tree">
      <log spec="TypedTreeLogger" tree="@tree" removeSingletonNodes="true" noLabels="true"/>
    </logger>
    
  </run>
</beast>
